__pycache__/
*.py[cod]
.pytest_cache/
.venv/
*.egg-info/
data/raw/*
models/*.pt
models/**/*.pt
logs/*
!**/.gitkeep

# The fine-tuned DistilBERT NER weights are ~254 MB, over GitHub's 100 MB
# per-file hard limit, so they are NOT committed. Regenerate in ~48 min on CPU:
#     python scripts/train_ner.py --samples 9000 --epochs 2
# Without it the pipeline falls back to the rule-based extractor and reports
# source="rule_fallback" rather than silently pretending it used the model.
models/ner/

# The scikit-learn artefacts (all under 4 MB) and the 25k synthetic corpus ARE
# committed, so a fresh clone can run the console without retraining anything.

# aiml/models/transformers/ (deberta_v3_small + distilbert_finetuned Trainer
# checkpoints) is NOT committed - same reason as models/ner/ above, except
# worse: full Trainer output includes optimizer.pt state, which is 1.1 GB per
# checkpoint and was previously committed by accident. Regenerate with:
#     python scripts/train_transformer_part1_bert_xgboost.py
#     python scripts/train_transformer_part2_finetune.py
models/transformers/

# yolov8n.pt (Live Safety Vision, ~6 MB) is covered by `models/*.pt` above and
# NOT committed. Ultralytics downloads and caches it into models/vision/ on
# first use — needs one internet connection, then works offline. Without it
# the vision detector reports model_ready=false with a readable error instead
# of crashing the backend; the report-analysis pipeline is unaffected either way.
